# ---------------------------------------------------------------------------
# Desktop client: JYI production gateway (override for a local product server).
# This file is a template; the launcher reads the process environment.
PYWEIXIN_GATEWAY_URL=https://gateway.jyisolutions.com

# ---------------------------------------------------------------------------
# Product gateway (cloud side). See docs/product-gateway.md.
# deploy/gateway.env.example is the authoritative template for a deployment.
# ---------------------------------------------------------------------------

# Public origin merchants' browsers visit. Must be https:// in production.
PYWEIXIN_PUBLIC_BASE_URL=https://gateway.example.com

# Operator API token. python -c "import secrets;print(secrets.token_urlsafe(32))"
PYWEIXIN_OPERATOR_TOKEN=

# Gateway bind and database.
PYWEIXIN_GATEWAY_HOST=127.0.0.1
PYWEIXIN_GATEWAY_PORT=8080
PYWEIXIN_PRODUCT_DB=product.db

# Single-instance gateway; the OpenCode backend is not a per-merchant sandbox.
PYWEIXIN_PARSE_WORKERS=1

# Platform budget / global concurrency. 0 = no limit. Free jobs are exempt.
# No CNY amounts by default: a subscription fee cannot be amortised per request,
# so the budget is counted in requests. See deploy/gateway.env.example.
PYWEIXIN_PLATFORM_DAILY_JOBS=0
PYWEIXIN_PLATFORM_MAX_CONCURRENCY=0
# PYWEIXIN_PLATFORM_COST_CENTS_PER_JOB=
# PYWEIXIN_PLATFORM_DAILY_COST_CENTS=

# Keep session cookies Secure in production. Set to 0 only for local http:// debugging.
PYWEIXIN_SECURE_COOKIES=1

# --- OpenCode execution backend (container network only) --------------------
# Leave the URL empty to run with the local rule adapter, which is NOT a model.
PYWEIXIN_OPENCODE_URL=http://opencode:4096
PYWEIXIN_OPENCODE_USER=opencode
# Required: the adapter refuses to start without a password, because an
# unauthenticated OpenCode server can be driven by anything on the network.
PYWEIXIN_OPENCODE_PASSWORD=
PYWEIXIN_OPENCODE_PROVIDER=opencode
PYWEIXIN_OPENCODE_MODEL=

# ---------------------------------------------------------------------------
# Merchant client (set in the Windows shop software's environment, not here).
# Credentials are stored with Windows DPAPI, not in a config file.
# ---------------------------------------------------------------------------
PYWEIXIN_GATEWAY_URL=https://gateway.example.com
PYWEIXIN_CLIENT_DB=client.db
PYWEIXIN_DEVICE_NAME=

# ---------------------------------------------------------------------------
# Existing local collector prototype. Unrelated to the product login flow.
# ---------------------------------------------------------------------------
PYWEIXIN_CLOUD_TOKEN=
PYWEIXIN_CONSOLE_TOKEN=
PYWEIXIN_AGENT_TOKENS={}
PYWEIXIN_BUSINESS_DB=orders.db
PYWEIXIN_DEMO_TOKEN=
PYWEIXIN_AGENT_ID=local-device
PYWEIXIN_ACCOUNT_ID=merchant-wechat-account
PYWEIXIN_GROUP=authorized-group-name
PYWEIXIN_AGENT_DB=agent.db
PYWEIXIN_DEVICE_TOKEN=
