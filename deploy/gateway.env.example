# Copy to deploy/gateway.env and fill in. Never commit the filled-in file.
# Every value here is a placeholder; no real secret belongs in this file.

# --- public entry point -------------------------------------------------------
# The exact origin merchants' browsers will visit. Must be https:// in
# production: the device-code link and the session cookie both depend on it.
WECHAT_AI_PUBLIC_BASE_URL=https://gateway.example.com

# --- gateway secrets ----------------------------------------------------------
# Operator API token. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
WECHAT_AI_OPERATOR_TOKEN=replace-with-32-byte-random-operator-token

# Set to 0 ONLY for local http:// debugging. Production must stay 1 so the
# browser session cookie is marked Secure.
WECHAT_AI_SECURE_COOKIES=1

WECHAT_AI_LOG_LEVEL=INFO

# --- parse queue --------------------------------------------------------------
# Single-instance gateway. Keep this at 1 for the pilot; the upstream OpenCode
# server is a single shared backend, not a per-merchant sandbox.
WECHAT_AI_PARSE_WORKERS=1

# --- OpenCode execution backend (container network only) ----------------------
# The gateway reaches OpenCode over the private compose network. The password
# is the HTTP basic credential of the OpenCode server itself.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-32-byte-random-opencode-password
#
# Prefer putting that password in a **file** and pointing at the file. The
# *content* and the *path* are deliberately two different fields, so a path can
# live in config while the secret never does:
#
#   python examples/prepare_isolated_opencode.py   # generates one, ACL-restricted
#   export WECHAT_AI_OPENCODE_PASSWORD_FILE=./.opencode-private/secret.pw
#
# A key in an env var ends up in deploy logs; a key on the command line ends up
# in `ps` output. The file path is not a secret, so it can live in config.
# `*.pw` is already git-ignored. If only WECHAT_AI_OPENCODE_PASSWORD is set, the
# gateway logs a warning that names the field — never the value.

# Upstream model credential. Lives only in the OpenCode container environment;
# it is never sent to the client, never written to the gateway database, and
# never included in an error message.
#
# LAUNCH CHECKLIST: the account behind this key must be one the operator is
# actually allowed to use for paying customers. Do not assume a personal
# OpenCode subscription can carry paid merchant traffic.
OPENCODE_MODEL_API_KEY=replace-with-upstream-model-api-key

# Model selection, as <provider>/<model> (see https://opencode.ai/docs/troubleshooting/).
# Must be replaced in deploy/opencode/opencode.json as well; the agent config
# pins the same model so a request cannot silently switch it.
WECHAT_AI_OPENCODE_PROVIDER=opencode
WECHAT_AI_OPENCODE_MODEL=PLACEHOLDER_MODEL_ID

# --- platform budget ----------------------------------------------------------
# The platform's own guard rails. All unset (or 0) = no limit, which is the
# safe default for a pilot. Enforcement is server-side; the client is never
# asked to police its own usage.
#
# A subscription fee cannot be reliably amortised per request, so the budget is
# expressed in requests and concurrency, NOT in money. Leave the two cost
# variables empty unless a real per-task price is known: with no price the
# operator view reports cost_known=false rather than inventing a CNY figure.
WECHAT_AI_PLATFORM_DAILY_JOBS=0            # paid jobs per day, 0 = unlimited
WECHAT_AI_PLATFORM_MAX_CONCURRENCY=0       # paid jobs running at once, 0 = unlimited
# WECHAT_AI_PLATFORM_COST_CENTS_PER_JOB=    # only when a real unit price exists
# WECHAT_AI_PLATFORM_DAILY_COST_CENTS=      # only when a real unit price exists
#
# Free jobs are exempt from the paid budget, otherwise switching the free quota
# on would immediately block every paying merchant. When the budget runs out the
# gateway stops accepting NEW execution jobs and returns
# `platform_budget_exhausted`; jobs already running finish normally and nothing
# in the merchant's local database is touched.

# --- subscription defaults (operator may override per account) ---------------
# Commercial pricing is NOT baked in. These are administrative starting values
# that an operator changes per account via the operator API.
WECHAT_AI_DEFAULT_PLAN_CODE=trial
WECHAT_AI_DEFAULT_QUOTA_UNITS=0
WECHAT_AI_DEFAULT_MAX_CONCURRENT_JOBS=2
WECHAT_AI_DEFAULT_PERIOD_DAYS=30
